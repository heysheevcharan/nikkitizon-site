---
/**
 * Portfolio: the same slides as Nikki's Canva website (same layout, same sizes and
 * positions for every photo, video and text), restyled in the site's fonts and colours.
 * Content lives in src/data/portfolio.json (/admin → Portfolio). Positions are percentages
 * of a 1440×768 slide, measured from the Canva site. Media is hosted on Cloudinary.
 */
import Base from '../layouts/Base.astro';
import portfolio from '../data/portfolio.json';

type Box = { x: number; y: number; w: number; h: number };
type Item = {
  type: 'image' | 'video' | 'text' | 'pin' | 'phone';
  box: Box;
  src?: string;
  alt?: string;
  crop?: Box;
  cutout?: boolean;
  text?: string;
  role?: 'display' | 'heading' | 'kicker' | 'label' | 'body';
  size?: number;
  align?: string;
  lh?: number;
  italic?: boolean;
  /** let the text wrap to its box instead of keeping Canva's line breaks */
  wrap?: boolean;
  captionFor?: number;
};
type Slide = { id: string; items: Item[] };
const slides = portfolio.slides as Slide[];

const SLIDE_W = 1440;
const SLIDE_H = 768;

// Cloudinary: right-sized, best-format files; videos get their first frame as a poster
const cld = (u: string, t: string) => u.replace('/upload/', `/upload/${t}/`);
const pxFor = (b: Box) => Math.min(1600, Math.ceil(((b.w / 100) * 1400 * 2) / 100) * 100);
const imgSrc = (it: Item) => cld(it.src!, `f_auto,q_auto,c_limit,w_${pxFor(it.box)}`);
const vidSrc = (it: Item) => cld(it.src!, 'q_auto,vc_auto,c_limit,w_720');
const poster = (it: Item) => cld(it.src!, `so_0,f_auto,q_auto,c_limit,w_${pxFor(it.box)}`).replace(/\.\w+$/, '.jpg');

// @handles and emails in Canva text become links
const linkify = (t: string) =>
  t
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/([\w.+-]+@[\w-]+\.[\w.]+)/g, '<a href="mailto:$1">$1</a>')
    .replace(/(^|\s)@([\w.]+)/g, '$1<a href="https://www.instagram.com/$2" target="_blank" rel="noopener noreferrer">@$2</a>')
    .split(/\n\n/)
    .map((para) => para.replace(/\n/g, ' <br>'))
    .join('<span class="para"></span>'); // blank line between paragraphs

const pct = (b: Box) => `left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%`;
// a caption's box relative to the photo/video it sits under
const rel = (c: Box, m: Box) =>
  `left:${(((c.x - m.x) / m.w) * 100).toFixed(2)}%;top:${(((c.y - m.y) / m.h) * 100).toFixed(2)}%;width:${((c.w / m.w) * 100).toFixed(2)}%`;
// reading order on phones: top to bottom, then left to right
const rank = (items: Item[]) => {
  const order = items
    .map((it, i) => ({ i, k: Math.round(it.box.y / 6) * 1000 + it.box.x }))
    .sort((a, b) => a.k - b.k);
  const r: number[] = [];
  order.forEach((o, n) => (r[o.i] = n));
  return r;
};
const firstOf = (id: string) => slides.findIndex((s) => s.id === id);
---

<Base
  title="Portfolio"
  description="Nikki Tizon: UGC creator and social media manager for hotels, Airbnbs, cafes and restaurants in the Philippines and India."
  bleed
  plain
>
  <h1 class="sr-only">Nikki Tizon: portfolio</h1>
  <div class="deck">
    {slides.map((s, si) => {
      const r = rank(s.items);
      return (
        <section class="slide" id={firstOf(s.id) === si ? s.id : undefined} style={`aspect-ratio:${SLIDE_W}/${SLIDE_H}`}>
          {s.items.map((it, i) => {
            if (it.type === 'text' && it.captionFor != null) return null; // drawn with its photo/video
            const style = `${pct(it.box)};--o:${r[i]}`;

            if (it.type === 'image' || it.type === 'video') {
              const caps = s.items.filter((c) => c.type === 'text' && c.captionFor === i);
              return (
                <figure
                  class:list={['m', { cutout: it.cutout, 'has-cap': caps.length }]}
                  style={`${style};--ar:${((it.box.w * SLIDE_W) / (it.box.h * SLIDE_H)).toFixed(4)}`}
                >
                  <div class="frame">
                    {it.type === 'video' ? (
                      <video
                        data-src={vidSrc(it)}
                        poster={poster(it)}
                        muted
                        loop
                        playsinline
                        preload="none"
                        style={it.crop ? pct(it.crop) : undefined}
                        class:list={{ crop: it.crop }}
                      />
                    ) : (
                      <img
                        src={imgSrc(it)}
                        alt={it.alt ?? ''}
                        loading={si < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                        style={it.crop ? pct(it.crop) : undefined}
                        class:list={{ crop: it.crop }}
                      />
                    )}
                  </div>
                  {caps.map((c) => (
                    <figcaption
                      class:list={['t', `t--${c.role}`]}
                      style={`${rel(c.box, it.box)};--s:${c.size};--lh:${c.lh ?? 1.35};text-align:${c.align}`}
                      set:html={linkify(c.text!)}
                    />
                  ))}
                </figure>
              );
            }

            if (it.type === 'text') {
              const Tag = it.role === 'display' ? 'h2' : it.role === 'heading' || it.role === 'kicker' ? 'h3' : 'p';
              return (
                <Tag
                  class:list={['t', `t--${it.role}`, { i: it.italic, wrap: it.wrap }]}
                  style={`${style};--s:${it.size};--lh:${it.lh ?? 1.35};text-align:${it.align}`}
                  set:html={linkify(it.text!)}
                />
              );
            }

            if (it.type === 'pin')
              return (
                <svg class="pin" style={style} viewBox="0 0 20 34" fill="currentColor" aria-hidden="true">
                  <path d="M10 0C4.5 0 0 4.4 0 9.9 0 17.3 10 34 10 34s10-16.7 10-24.1C20 4.4 15.5 0 10 0Zm0 14.2a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6Z" />
                </svg>
              );

            if (it.type === 'phone') return <div class="phone" style={style} aria-hidden="true" />;
            return null;
          })}
        </section>
      );
    })}
  </div>
</Base>

<style>
  .deck {
    max-width: 1440px;
    margin: 0 auto;
    padding: calc(var(--frame) + 8px) 0 calc(var(--frame) + 24px);
  }
  .slide {
    position: relative;
    width: 100%;
    container-type: inline-size;
    scroll-margin-top: 12px;
  }

  /* photos & videos: same box, same crop as the Canva slide */
  .m {
    position: absolute;
    margin: 0;
  }
  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--paper-warm);
  }
  .frame img,
  .frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame .crop {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }
  .cutout .frame { overflow: visible; background: none; }
  .cutout .frame img { object-fit: contain; }
  .m figcaption { position: absolute; margin: 0; }

  /* text: Canva's positions and sizes, the site's fonts and red */
  .t {
    position: absolute;
    margin: 0;
    color: var(--red);
    font-size: calc(var(--s) * 0.94cqw); /* Inter Tight runs a little wider than Canva's serif */
    line-height: var(--lh);
    overflow-wrap: break-word;
  }
  .t :global(a) { color: inherit; text-decoration-color: var(--line); }
  .t :global(a:hover) { text-decoration-color: var(--red); }
  .t--display {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: calc(var(--s) * 1.15cqw);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .t--display.i { font-style: italic; }
  .t--heading {
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .slide:nth-child(2) .t--display {
    /* "HELLO, I'M NIKKI": Canva sets it in bold caps */
    letter-spacing: 0.01em;
  }
  .t--kicker {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }
  .t--label {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .t--body { font-weight: 400; white-space: nowrap; }
  .t.wrap { white-space: normal; }

  .pin { position: absolute; color: var(--red); }
  .phone {
    position: absolute;
    border: 0.2cqw solid var(--red);
    border-radius: 2.4cqw;
  }

  /* phones: the slides reflow into a simple two-column layout in reading order */
  @media (max-width: 900px) {
    .deck { padding: 8px 20px 64px; }
    .slide {
      aspect-ratio: auto !important;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 12px;
      padding: 40px 0 8px;
      border-top: 1px solid var(--line);
    }
    .slide:first-child { border-top: 0; padding-top: 16px; }
    .slide > * {
      position: static !important;
      width: auto !important;
      height: auto !important;
      order: var(--o);
    }
    .t { grid-column: 1 / -1; text-align: left !important; white-space: normal !important; line-height: 1.45; }
    .t--display { font-size: clamp(40px, 12vw, 56px); }
    .t--heading { font-size: 15px; margin-top: 8px; }
    .t--kicker { font-size: 12px; }
    .t--label { font-size: 12px; }
    .t--body { font-size: 16px; }
    .m { display: flex; flex-direction: column; gap: 8px; }
    .frame { position: relative; aspect-ratio: var(--ar); }
    .m figcaption { position: static; width: auto !important; font-size: 11px; text-align: center !important; }
    .cutout { grid-column: 1 / -1; width: 70% !important; justify-self: center; }
    .phone, .pin { display: none; }
  }
</style>

<style is:global>
  /* inside the slide text (set:html), so these can't be scoped */
  .slide .t .para { display: block; height: calc(var(--lh) * 1em); }
  @media (max-width: 900px) {
    .slide .t br { display: none; } /* let text wrap naturally on small screens */
    .slide .t .para { height: 0.7em; }
  }
</style>
