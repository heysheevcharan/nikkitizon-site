---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const allHomePages = await getCollection('home');
const homePage = allHomePages[0];
if (!homePage) throw new Error('home.mdx not found in src/content/home/');
const { Content } = await render(homePage);
const home = homePage.data;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: home.name ?? SITE.name,
  url: Astro.site,
  description: home.tagline,
  sameAs: [home.twitter, home.github, home.linkedin].filter(Boolean),
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Base title={SITE.name} description={home.tagline || SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <header class="home-head">
    <h1>{home.name ?? home.title}</h1>
    {home.tagline && <p class="text-muted home-tagline">{home.tagline}</p>}
  </header>

  <div class="prose">
    <Content />
  </div>

  {
    posts.length > 0 && (
      <>
        <hr class="divider" />
        <h2 id="writing" style="margin-top: 0;">writing</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-list-item">
              <span class="log-date post-list-date">{formatDate(post.data.pubDate)}</span>
              <a href={`/blog/${post.id}`} class="post-list-link">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
        <a href="/blog" class="text-muted" style="font-size: 0.875rem;">
          all posts &rarr;
        </a>
      </>
    )
  }

  {
    (home.email || home.github || home.twitter || home.linkedin) && (
      <>
        <hr class="divider" />
        <h2 id="elsewhere" style="margin-top: 0;">elsewhere</h2>
        <ul class="elsewhere-list">
          {home.email && (
            <li>
              <a href={`mailto:${home.email}`}>email</a>
            </li>
          )}
          {home.github && (
            <li>
              <a href={home.github} target="_blank" rel="noopener noreferrer">
                github
              </a>
            </li>
          )}
          {home.twitter && (
            <li>
              <a href={home.twitter} target="_blank" rel="noopener noreferrer">
                x.com
              </a>
            </li>
          )}
          {home.linkedin && (
            <li>
              <a href={home.linkedin} target="_blank" rel="noopener noreferrer">
                linkedin
              </a>
            </li>
          )}
        </ul>
      </>
    )
  }

  {SITE.substackEmbed && <hr class="divider" />}
  <Newsletter heading />
</Base>

<style>
  .home-head h1 {
    margin: 0 0 0.5rem;
  }
  .home-tagline {
    margin: 0 0 2rem;
    font-size: 0.95rem;
  }
</style>
