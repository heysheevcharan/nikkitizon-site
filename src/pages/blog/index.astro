---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

// Group by year
const grouped = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));

function truncate(text: string, maxChars = 120): string {
  if (!text || text.length <= maxChars) return text;
  return text.slice(0, maxChars).replace(/\s\S*$/, '') + '…';
}
---

<Base
  title="Writing"
  description={`All posts by ${SITE.name}.`}
>
  <header class="blog-head">
    <span class="kicker">{posts.length} {posts.length === 1 ? 'essay' : 'essays'}</span>
    <h1>Writing</h1>
    <p class="blog-sub">Letters and notes, mostly about love, work and being seen.</p>
  </header>

  {years.map((year) => (
    <section class="year-section">
      <h2 class="year-heading kicker">{year}</h2>
      <ul class="blog-index-list">
        {grouped[year].map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="blog-row">
              <span class="kicker blog-date">{formatDate(post.data.pubDate)}</span>
              <span class="blog-main">
                <span class="blog-title">{post.data.title}</span>
                {post.data.description && <span class="blog-desc">{truncate(post.data.description)}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {posts.length === 0 && <p>No posts yet. Check back soon.</p>}

  <Newsletter />
</Base>

<style>
  .blog-head { margin-bottom: 72px; }
  .blog-head h1 { font-size: clamp(4rem, 9vw, 7rem); line-height: 0.9; margin: 14px 0 18px; }
  .blog-sub { font-size: 18px; }
  .year-section { margin-bottom: 64px; }
  .year-heading { font-family: var(--font-sans); font-size: 12px; margin: 0; padding-bottom: 12px; border-bottom: 1px solid var(--red); }
  .blog-index-list { list-style: none; }
  .blog-index-list li { border-bottom: 1px solid var(--line); }
  .blog-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 26px 0;
    text-decoration: none;
    color: var(--red);
  }
  .blog-date { padding-top: 10px; }
  .blog-main { display: flex; flex-direction: column; gap: 8px; }
  .blog-title { font: 400 34px/1.05 var(--font-serif); letter-spacing: -0.02em; transition: translate 0.25s; }
  .blog-desc { font-size: 15px; line-height: 1.55; opacity: 0.85; }
  .blog-row:hover .blog-title { font-style: italic; translate: 6px 0; }
  @media (max-width: 600px) {
    .blog-row { grid-template-columns: 1fr; gap: 6px; }
    .blog-date { padding-top: 0; }
    .blog-title { font-size: 28px; }
  }
</style>
