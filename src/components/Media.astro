---
/**
 * One photo or video on the scrapbook. Looks up its file in src/data/media.json by id;
 * while that src is empty it shows a labeled placeholder of the right shape.
 */
import media from '../data/media.json';

interface Props {
  /** spot name in src/data/media.json (or pass src directly) */
  id?: string;
  src?: string;
  poster?: string;
  alt?: string;
  kind?: 'photo' | 'video';
  /** CSS aspect-ratio, e.g. "3 / 4", "9 / 16" */
  ratio?: string;
  caption?: string;
  treatment?: 'polaroid' | 'tape' | 'tape2' | 'clip' | 'plain';
  /** degrees */
  rotate?: number;
  /** px */
  width?: number;
  eager?: boolean;
  /** fade in on scroll (default true) */
  reveal?: boolean;
  class?: string;
  style?: string;
}

const {
  id = '',
  kind = 'photo',
  ratio: ratioProp,
  caption,
  treatment = 'polaroid',
  rotate = 0,
  width = 220,
  eager = false,
  reveal = true,
  class: cls,
  style = '',
} = Astro.props;

const fromData = (media as Record<string, { src?: string; poster?: string; alt?: string; ratio?: string }>)[id] ?? {};
// frame shape: an explicit ratio wins, then the file's real shape (media.json), then a default
const ratio = ratioProp ?? (fromData.src ? fromData.ratio : undefined) ?? (kind === 'video' ? '9 / 16' : '3 / 4');
const entry = {
  src: Astro.props.src ?? fromData.src,
  poster: Astro.props.poster ?? fromData.poster,
  alt: Astro.props.alt ?? fromData.alt,
};
const raw = entry.src?.trim();
const isVideo = raw ? /\/video\/upload\/|\.(mp4|webm|mov)$/i.test(raw) : kind === 'video';
const alt = entry.alt || caption || '';

// Cloudinary: ask for the right size and the best format for the browser.
// e.g. https://res.cloudinary.com/<cloud>/image/upload/v1/x.jpg -> .../upload/f_auto,q_auto,c_limit,w_600/v1/x.jpg
const isCloudinary = (u?: string) => !!u && /^https:\/\/res\.cloudinary\.com\/.+\/upload\//.test(u);
const cld = (u: string, t: string) => u.replace('/upload/', `/upload/${t}/`);
const px = Math.min(1600, Math.round(width * 2)); // 2x for sharp screens
const src = raw && isCloudinary(raw)
  ? cld(raw, isVideo ? `q_auto,vc_auto,c_limit,w_${Math.max(540, px)}` : `f_auto,q_auto,c_limit,w_${px}`)
  : raw;
const posterRaw = entry.poster?.trim();
const poster = posterRaw
  ? isCloudinary(posterRaw) ? cld(posterRaw, `f_auto,q_auto,c_limit,w_${px}`) : posterRaw
  : isVideo && raw && isCloudinary(raw)
    ? cld(raw, `so_0,f_auto,q_auto,c_limit,w_${px}`).replace(/\.\w+$/, '.jpg') // first frame of the video
    : undefined;
---

<figure
  class:list={['scrap', `scrap--${treatment}`, { 'has-caption': caption, reveal }, cls]}
  style={`--w:${width}px;--r:${rotate}deg;--ratio:${ratio};${style}`}
>
  <div class="scrap-inner">
    {treatment === 'clip' && (
      <svg class="clip" viewBox="0 0 22 56" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 14V44a5 5 0 0 1-10 0V9a7 7 0 0 1 14 0v33a3 3 0 0 1-6 0V16" stroke-linecap="round" />
      </svg>
    )}
    <div class="scrap-media">
      {src ? (
        isVideo ? (
          <video
            data-src={src}
            poster={poster}
            muted
            loop
            playsinline
            preload="none"
            aria-label={alt}
          />
        ) : (
          <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
        )
      ) : (
        <div class="placeholder" role="img" aria-label={`placeholder for ${kind}: ${id}`}>
          {kind === 'video' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="13" height="14" rx="2" /><path d="M16 10l5-3v10l-5-3" stroke-linejoin="round" /></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="2" /><circle cx="12" cy="13" r="3.5" /><path d="M8 6l1.5-2h5L16 6" stroke-linejoin="round" /></svg>
          )}
          <span class="placeholder-kind">{kind}</span>
          <span class="placeholder-id">{id}</span>
        </div>
      )}
    </div>
    {caption && <figcaption>{caption}</figcaption>}
  </div>
</figure>
