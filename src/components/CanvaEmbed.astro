---
/**
 * Embeds a Canva design. Accepts what Canva's Share → Embed gives you: either the
 * link (https://www.canva.com/design/<id>/<token>/view?embed) or the full embed code,
 * or a path on this site (e.g. /ugc-portfolio, a Canva website proxied in vercel.json).
 * When the embed code is pasted, its `padding-top: N%` (the design's height ÷ width)
 * is used so the whole design shows at its real shape instead of in a scroll box.
 */
interface Props {
  value: string;
  title?: string;
  /** edge-to-edge with no frame, so the design reads as the page itself */
  fullBleed?: boolean;
}
const { value, title = 'Canva design', fullBleed = false } = Astro.props;

function toEmbedUrl(raw: string): string | null {
  const src = raw.match(/src=["']([^"']+)["']/)?.[1] ?? raw.trim();
  // a path on this site, e.g. /ugc-portfolio (the published Canva site, proxied by vercel.json
  // so it can be framed and keeps its autoplaying videos)
  if (/^\/[\w\-/]*$/.test(src)) return src;
  let url: URL;
  try {
    url = new URL(src.replace(/&amp;/g, '&'));
  } catch {
    return null;
  }
  if (!/(^|\.)canva\.com$/.test(url.hostname) || !url.pathname.startsWith('/design/')) return null;
  // a plain share link (…/view or …/edit) becomes the embeddable viewer
  url.pathname = url.pathname.replace(/\/(edit|watch)$/, '/view');
  if (!url.pathname.endsWith('/view')) url.pathname = url.pathname.replace(/\/?$/, '/view');
  url.search = '?embed';
  return url.toString();
}
const embedUrl = toEmbedUrl(value);
const ratio = Number(value.match(/padding-top:\s*([\d.]+)%/)?.[1]) || 0; // height as % of width
const sized = ratio > 0 && ratio < 5000;
// full-bleed: size the frame from just below the nav to the bottom of the window
const fitScript = `(() => {
  const el = document.currentScript.previousElementSibling;
  const fit = () => el && document.documentElement.style.setProperty('--canva-top', el.getBoundingClientRect().top + window.scrollY + 'px');
  fit();
  addEventListener('resize', fit);
})();`;
---

{
  embedUrl && (
    <div class:list={['canva-embed', { 'is-sized': sized, 'is-bleed': fullBleed }]} style={sized ? `--canva-ratio: ${ratio}%` : undefined}>
      <iframe src={embedUrl} title={title} loading="lazy" allow="fullscreen; autoplay" allowfullscreen />
    </div>
  )
}

{
  fullBleed && embedUrl && (
    <script is:inline set:html={fitScript} />
  )
}

<style>
  /* breaks out of the 640px text column so the design gets some room */
  .canva-embed {
    position: relative;
    width: min(1000px, calc(100vw - 2rem));
    left: 50%;
    transform: translateX(-50%);
    height: min(85svh, 900px);
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  /* real shape of the design (from Canva's embed code): the page scrolls, not the frame */
  .canva-embed.is-sized {
    height: 0;
    padding-top: var(--canva-ratio);
  }
  /* edge to edge, no card: the design is the page. The frame fills the main column below the top bar
     and Canva's viewer scrolls inside it: one smooth scroller, and Canva only renders (and
     plays) what's on screen instead of a 20,000px-tall frame with every video running. */
  .canva-embed.is-bleed {
    width: 100%;
    left: 0;
    transform: none;
    height: calc(100dvh - var(--canva-top, 0px));
    padding-top: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  :global(html:has(.canva-embed.is-bleed)) {
    overflow: hidden; /* the embed is the only scroller on this page */
  }
  .canva-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
